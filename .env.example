PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

MONGODB_URI=mongodb://localhost:27018/tradertavern

JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d

# 32-byte hex string (64 chars) used to encrypt broker credentials at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-32-byte-hex-in-local-env

AUTH_COOKIE_NAME=access_token

RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# Number of candles to retain per ticker for each technical data window.
CANDLE_COUNT_5M=100
CANDLE_COUNT_1H=200
CANDLE_COUNT_1D=100
CANDLE_COUNT_1W=52
