# Used by docker-compose.prod.yml on the deployment host (NUC).
# Copy to .env.production (gitignored) and fill in real values.

# Registry image to pull (pushed by CI on every merge to main).
REGISTRY=registry.noguetith.fr
IMAGE_TAG=latest

# Public domain the app is served under. The reverse proxy (nginx,
# configured separately) must route:
#   https://<DOMAIN>/       -> this host, port 4710
#   https://<DOMAIN>/api    -> this host, port 4711
DOMAIN=change-me.example.com

# Optional: only set this if the API should be served on its own domain
# (e.g. api.change-me.example.com) instead of under DOMAIN's /api path.
# Requires the reverse proxy to route that domain's root to port 4711.
#API_DOMAIN=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
RESET_PASSWORD_TOKEN_TTL_MINUTES=30

CANDLE_COUNT_5M=100
CANDLE_COUNT_1H=200
CANDLE_COUNT_1D=100
CANDLE_COUNT_1W=52
